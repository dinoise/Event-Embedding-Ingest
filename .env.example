# Environment: dev or prod (selects the config class in config.py)
ENV=dev

# Legacy/compat flag also read by config.py
FLASK_ENV=dev

# GCP project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Set automatically in Cloud Run/Cloud Functions; leave unset for local runs.
# Used to pick the private vs. public Postgres host secret.
# CLOUD_VAR=true

# Vertex AI embedding model used to generate the 768-dim vectors
EMBEDDING_MODEL_NAME=text-embedding-004

# Note: PostgreSQL credentials (host, port, user, password, database) are NOT
# read from env vars. config.py holds the *names* of the Secret Manager
# secrets (e.g. POSTGRE_USR_RAG_REPO_DEV), which are resolved at runtime via
# get_secret(). Ensure those secrets exist in Secret Manager for your project.
